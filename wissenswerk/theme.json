{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"color": {
			"custom": true,
			"customGradient": true,
			"link": true,
			"palette": [
				{ "slug": "primary", "color": "#4f46e5", "name": "Primär" },
				{ "slug": "primary-dark", "color": "#3730a3", "name": "Primär Dunkel" },
				{ "slug": "accent", "color": "#06b6d4", "name": "Akzent" },
				{ "slug": "ink", "color": "#0f172a", "name": "Tinte" },
				{ "slug": "muted", "color": "#64748b", "name": "Gedämpft" },
				{ "slug": "surface", "color": "#f8fafc", "name": "Oberfläche" },
				{ "slug": "surface-alt", "color": "#eef2ff", "name": "Oberfläche Alt" },
				{ "slug": "white", "color": "#ffffff", "name": "Weiß" }
			],
			"gradients": [
				{
					"slug": "brand",
					"gradient": "linear-gradient(135deg, #4f46e5 0%, #06b6d4 100%)",
					"name": "Marke"
				},
				{
					"slug": "dusk",
					"gradient": "linear-gradient(135deg, #3730a3 0%, #0f172a 100%)",
					"name": "Dämmerung"
				}
			]
		},
		"typography": {
			"customFontSize": true,
			"lineHeight": true,
			"fontFamilies": [
				{
					"fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
					"slug": "sans",
					"name": "Sans"
				},
				{
					"fontFamily": "'Merriweather', Georgia, 'Times New Roman', serif",
					"slug": "serif",
					"name": "Serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.875rem", "name": "Klein" },
				{ "slug": "medium", "size": "1.125rem", "name": "Mittel" },
				{ "slug": "large", "size": "1.5rem", "name": "Groß" },
				{ "slug": "x-large", "size": "2.25rem", "name": "Sehr groß" },
				{ "slug": "xx-large", "size": "3rem", "name": "Riesig" }
			]
		},
		"spacing": {
			"units": ["px", "em", "rem", "vh", "vw", "%"],
			"padding": true,
			"margin": true,
			"blockGap": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "1.0625rem",
			"lineHeight": "1.7"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" }
			},
			"h1": { "typography": { "fontWeight": "800", "lineHeight": "1.15" } },
			"h2": { "typography": { "fontWeight": "700", "lineHeight": "1.2" } },
			"h3": { "typography": { "fontWeight": "700", "lineHeight": "1.25" } }
		}
	}
}
